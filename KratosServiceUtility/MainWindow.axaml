<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="KratosServiceUtility.MainWindow"
        Title="Kratos Service Utility"
        Width="500"
        Height="360"
        MinWidth="500"
        MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="Black"
	Icon="/Resources/kratos.png">

    <!-- Viewbox scales the whole 500x360 UI when the user resizes -->
    <Viewbox Stretch="Fill">
        <Grid Width="500" Height="360">
            <!-- Plasma background -->
            <Image x:Name="PlasmaImage"
                   Stretch="Fill"
                   RenderOptions.BitmapInterpolationMode="None"
                   UseLayoutRounding="True" />

            <!-- Foreground layout -->
            <Canvas>

                <!-- Header bar -->
                <Rectangle Canvas.Left="0" Canvas.Top="0"
                           Width="500" Height="70"
                           Fill="#020617" />
                <TextBlock Canvas.Left="25" Canvas.Top="10"
                           Text="Kratos Service Util"
                           FontFamily="Consolas"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#00adff" />
                <TextBlock Canvas.Left="25" Canvas.Top="43"
                           Text="EqUiNoX × Team Resurgent × darkone83"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#9ca3af" />

                <!-- Music toggle (top-right) -->
                <CheckBox x:Name="MusicCheckBox"
                          Canvas.Left="380" Canvas.Top="34"
                          Content="Play Music"
                          FontFamily="Consolas"
                          FontSize="12"
                          Foreground="#39FF14"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          Click="MusicCheckBox_Click" />

                <!-- Thin neon separator -->
                <Rectangle Canvas.Left="0" Canvas.Top="70"
                           Width="500" Height="1"
                           Fill="#1e293b" />

                <!-- Device Port -->
                <TextBlock Canvas.Left="25" Canvas.Top="92"
                           Text="Device Port:"
                           FontFamily="Consolas"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#e5e7eb" />
                <ComboBox x:Name="PortCombo"
                           Canvas.Left="110" Canvas.Top="83"
                           Width="200"
                           FontFamily="Consolas"
                           FontSize="10"
                           Background="#020b1f"
                           Foreground="#e5e7eb"
                           BorderBrush="#1f2937"
                           BorderThickness="1"
                           SelectionChanged="PortCombo_SelectionChanged" />
                <Button x:Name="RefreshPortsButton"
                        Canvas.Left="320" Canvas.Top="83"
                        Width="60" Height="32"
                        Content="Refresh"
                        FontFamily="Consolas"
                        FontSize="11"
                        Background="#020b1f"
                        Foreground="#e5e7eb"
                        BorderBrush="#1f2937"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="RefreshPortsButton_Click" />

                <!-- Linux-only: appears when the selected port needs permission fixing -->
                <Button x:Name="FixPermsButton"
                        IsVisible="False"
                        Canvas.Left="385" Canvas.Top="83"
                        Width="90" Height="32"
                        Content="Fix Access"
                        FontFamily="Consolas"
                        FontSize="10"
                        Background="#b45309"
                        Foreground="White"
                        BorderBrush="Transparent"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="FixPermsButton_Click" />

                <!-- Firmware selection -->
                <TextBlock Canvas.Left="25" Canvas.Top="137"
                           Text="Firmware:"
                           FontFamily="Consolas"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#e5e7eb"/>
                <TextBox x:Name="FirmwarePathText"
                         Canvas.Left="110" Canvas.Top="128"
                         Width="200"
                         FontFamily="Consolas"
                         FontSize="10"
                         IsReadOnly="True"
                         Background="#020b1f"
                         Foreground="#e5e7eb"
                         BorderBrush="#1f2937" />
                <Button x:Name="BrowseFirmwareButton"
                        Canvas.Left="320" Canvas.Top="128"
                        Width="60" Height="32"
                        Content="Browse"
                        FontFamily="Consolas"
                        FontSize="10"
                        Background="#020b1f"
                        Foreground="#e5e7eb"
                        BorderBrush="#1f2937"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="BrowseFirmwareButton_Click" />

                <!-- Progress bar -->
                <ProgressBar x:Name="MainProgressBar"
                             Canvas.Left="25" Canvas.Top="175"
                             Width="450" Height="16"
                             Minimum="0" Maximum="100"
                             Background="#020617"
                             Foreground="#22d3ee" />

                <!-- Status + percentage -->
                <TextBlock x:Name="StatusTextBlock"
                           Canvas.Left="25" Canvas.Top="200"
                           Width="360"
                           Text="Ready"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#cbd5f5" />
                <TextBlock x:Name="ProgressPercentText"
                           Canvas.Left="390" Canvas.Top="200"
                           Width="85"
                           Text="0%"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#cbd5f5"
                           TextAlignment="Right" />

                <!-- Action buttons -->
                <Button x:Name="FlashButton"
                        Canvas.Left="25" Canvas.Top="235"
                        Width="150" Height="40"
                        Content="FLASH FIRMWARE"
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="Bold"
                        Background="#16a34a"
                        Foreground="White"
                        BorderBrush="Transparent"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Click="FlashButton_Click" />

                <Button x:Name="EraseButton"
                        IsVisible="False"
                        Canvas.Left="180" Canvas.Top="235"
                        Width="150" Height="40"
                        Content="ERASE MEMORY"
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="Bold"
                        Background="#dc2626"
                        Foreground="White"
                        BorderBrush="Transparent"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Click="EraseButton_Click" />

                <Button x:Name="DumpButton"
                        IsVisible="False"
                        Canvas.Left="335" Canvas.Top="235"
                        Width="150" Height="40"
                        Content="DUMP FIRMWARE"
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="Bold"
                        Background="#0ea5e9"
                        Foreground="White"
                        BorderBrush="Transparent"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Click="DumpButton_Click" />

                <!-- Footer line -->
                <Rectangle Canvas.Left="0" Canvas.Top="315"
                           Width="500" Height="1"
                           Fill="#1e293b" />
                <!-- Footer credits -->
                <TextBlock Canvas.Left="25" Canvas.Top="330"
                           Width="450"
                           Text="KratOS Firmware: EqUiNoX  ·  Service Util: Darkone83 / EqUiNoX"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="White"
                           TextAlignment="Center">
                </TextBlock>

            </Canvas>
            
        </Grid>
    </Viewbox>
</Window>

